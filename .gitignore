# Dependencies and local build/runtime artifacts — never source.
# NOTE: static/ (the built SPA) is intentionally tracked: the Databricks Apps
# deploy uploads it, and `databricks sync` honours this file, so ignoring it
# would break the deploy.
frontend/node_modules/
frontend/*.tsbuildinfo
.venv/
__pycache__/
*.pyc
.DS_Store

# Seed data (db/seed_data/vendor_supply_region.csv) is now tracked so a clone
# in any workspace can seed on deploy. Regenerate it from the source spreadsheet
# with db/seed_data/build_seed.py. The raw spreadsheet itself stays untracked.

# Raw customer source files — kept locally, never committed or uploaded to the
# workspace by `databricks bundle deploy` (bundle sync honours this file).
*.XLSX
*.xlsx
*.eml
